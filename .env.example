# Smart City Traffic System Environment Configuration
# Copy this file to .env before starting the application

PROJECT_NAME="Smart City Traffic Route Optimization & Management System"
VERSION=1.0.0
ENV=development
DEBUG=true

# Security
SECRET_KEY=smart-city-pune-hinjawadi-traffic-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite out-of-the-box configuration:
DATABASE_URL=sqlite:///./traffic_system.db

# Optional Production PostgreSQL with PostGIS:
# DATABASE_URL=postgresql+psycopg2://traffic_user:traffic_pass@localhost:5432/pune_traffic_db

# Geographic Focus
DEFAULT_CITY="Pune, Maharashtra, India"
DEFAULT_AREA="Hinjawadi, Pune"
DEFAULT_LATITUDE=18.5913
DEFAULT_LONGITUDE=73.7389
DEFAULT_ZOOM=13
TIMEZONE=Asia/Kolkata

# Simulation & Cache Controls
SIMULATION_MODE=true
DATA_FRESHNESS_TTL_SECONDS=120
MAX_SEARCH_RADIUS_KM=25.0
